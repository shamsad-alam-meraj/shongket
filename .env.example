# Public URL of the deployment (used for metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://shongket.example

# Optional — real-time traffic incidents (jams, closures, accidents, roadworks with causes).
# Free key (no card): https://my.tomtom.com/  → verify with `npm run check:traffic`
# Free tier ≈ 2,500 requests / month: requests are shared per ~16 km area and cached.
TOMTOM_API_KEY=
# Per-instance daily request cap (default 80 ≈ 2,400 / month) and cache window in minutes (default 20)
TOMTOM_DAILY_LIMIT=80
TOMTOM_CACHE_MINUTES=20
# Areas with no TomTom coverage (no incidents) are re-checked this rarely, in minutes (default 180)
TOMTOM_EMPTY_CACHE_MINUTES=180

# Recommended in production — durable, shared store for community reports.
# Without it, reports use .data/reports.json locally, or process memory on read-only hosts.
# Free tier: https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
